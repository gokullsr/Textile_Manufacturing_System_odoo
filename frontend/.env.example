# Backend API Base URL (must be prefixed with VITE_)
VITE_API_URL=http://localhost:5000

# Public App Base URL for QR Code Destination Generation
# For local mobile testing via Wi-Fi: set to your computer's LAN IP (e.g. http://192.168.1.100:5173)
# For production deployment: set to your Vercel URL (e.g. https://loomiq.vercel.app)
VITE_PUBLIC_APP_URL=http://localhost:5173
