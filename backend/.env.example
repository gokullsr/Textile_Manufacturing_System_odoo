# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local format: mongodb://127.0.0.1:27017/loomiq
MONGODB_URI=mongodb://127.0.0.1:27017/loomiq

# Allowed CORS Origins (comma-separated list, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
